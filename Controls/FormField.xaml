<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TransportDouala.Controls.FormField">
    <VerticalStackLayout Spacing="6">
        <Label x:Name="TitleLabel" FontAttributes="Bold" />
        <Border x:Name="FieldBorder" Style="{StaticResource FieldBorder}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="Input" TextChanged="OnInputChanged" />
                <Label x:Name="TrailLabel" Grid.Column="1" VerticalOptions="Center" FontSize="14" IsVisible="False">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrailTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>
        <Label x:Name="ErrorLabel" FontSize="13" TextColor="{StaticResource Danger}" IsVisible="False" />
    </VerticalStackLayout>
</ContentView>
