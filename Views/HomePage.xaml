<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:TransportDouala.ViewModels" xmlns:m="clr-namespace:TransportDouala.Models" xmlns:ctl="clr-namespace:TransportDouala.Controls" xmlns:draw="clr-namespace:TransportDouala.Drawing" x:Class="TransportDouala.Views.HomePage" x:DataType="vm:HomeViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="20,28" Spacing="16">
            <Label Text="Bonjour 👋" Style="{StaticResource Title}" FontSize="30" />
            <Label Text="Où souhaitez-vous aller ?" FontSize="17" />

            <Border Style="{StaticResource FieldBorder}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="🔍" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Placeholder="Rechercher une destination" Text="{Binding Query, Mode=TwoWay}"
                           ReturnType="Search" ReturnCommand="{Binding SearchCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0" HeightRequest="230">
                <Grid>
                    <GraphicsView x:Name="MapView">
                        <GraphicsView.Drawable><draw:MapDrawable /></GraphicsView.Drawable>
                    </GraphicsView>
                    <Border Style="{StaticResource Chip}" BackgroundColor="White" HorizontalOptions="Start" VerticalOptions="Start" Margin="10">
                        <Label Text="●  Votre position" FontSize="13" />
                    </Border>
                    <Border BackgroundColor="White" Stroke="{StaticResource BorderBrush}" WidthRequest="44" HeightRequest="44"
                            HorizontalOptions="End" VerticalOptions="End" Margin="10" StrokeShape="RoundRectangle 10">
                        <Label Text="◎" FontSize="22" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnLocateTapped" /></Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>
            <Label Text="Carte et données illustratives · position simulée, non fiable pour la géolocalisation." Style="{StaticResource Muted}" FontSize="13" />

            <Label Text="Arrêts à proximité" Style="{StaticResource H2}" Margin="0,8,0,0" />
            <Label Text="Aucun arrêt à proximité pour le moment." Style="{StaticResource Muted}" IsVisible="{Binding HasNoNearby}" />
            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding NearbyStops}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:NearbyStop">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Label Text="🚌" FontSize="22" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding Info}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnStopTapped" /></Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
