<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:TransportDouala.ViewModels" xmlns:m="clr-namespace:TransportDouala.Models" xmlns:ctl="clr-namespace:TransportDouala.Controls" xmlns:draw="clr-namespace:TransportDouala.Drawing" x:Class="TransportDouala.Views.ResultsPage" x:DataType="vm:ResultsViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="20,20" Spacing="14">
            <Label Style="{StaticResource BackArrow}">
                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding GoBackCommand}" /></Label.GestureRecognizers>
            </Label>
            <Label Text="Résultats de l'itinéraire" Style="{StaticResource Title}" />
            <Border Style="{StaticResource Card}" Padding="14">
                <Label Text="{Binding Summary}" FontSize="16" />
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" HeightRequest="32" />
            <Label Text="Aucun itinéraire direct trouvé entre ces deux points. Modifiez le départ ou la destination."
                   Style="{StaticResource Muted}" FontSize="15" IsVisible="{Binding IsEmpty}" />

            <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Items}"
                                 BindableLayout.ItemTemplate="{StaticResource RouteCardTemplate}" />

            <Label Text="Durées estimées et tarifs indicatifs. Les arrêts affichés correspondent au trajet recherché."
                   Style="{StaticResource Muted}" FontSize="13" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
