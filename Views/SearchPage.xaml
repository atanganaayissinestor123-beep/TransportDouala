<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:TransportDouala.ViewModels" xmlns:m="clr-namespace:TransportDouala.Models" xmlns:ctl="clr-namespace:TransportDouala.Controls" xmlns:draw="clr-namespace:TransportDouala.Drawing" x:Class="TransportDouala.Views.SearchPage" x:DataType="vm:SearchViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="20,28" Spacing="14">
            <Label Text="Rechercher un itinéraire" Style="{StaticResource Title}" />

            <ctl:FormField Title="Départ" Placeholder="Ma position actuelle" ActionText="📍"
                           Text="{Binding Departure, Mode=TwoWay}" ActionCommand="{Binding UseCurrentPositionCommand}" />
            <Button Text="↕" HorizontalOptions="End" WidthRequest="56" HeightRequest="46" Style="{StaticResource SecondaryButton}"
                    FontSize="20" Command="{Binding SwapCommand}" />
            <ctl:FormField Title="Destination" Placeholder="Où allez-vous ?" Suffix="📍" Text="{Binding Destination, Mode=TwoWay}" />

            <Label Text="Position de démonstration. Vous pouvez saisir un arrêt comme point de départ." Style="{StaticResource Muted}" />

            <Border IsVisible="{Binding HasError}" Style="{StaticResource Chip}" BackgroundColor="{StaticResource DangerBg}">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
            </Border>

            <Button Text="Rechercher l'itinéraire" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" />

            <Label Text="Destinations récentes" Style="{StaticResource H2}" Margin="0,10,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recent}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,16" BackgroundColor="Transparent">
                                <Label Text="🕘" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding .}" FontSize="16" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="↖" FontSize="18" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRecentTapped" /></Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
