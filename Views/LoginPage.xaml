<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:TransportDouala.ViewModels" xmlns:m="clr-namespace:TransportDouala.Models" xmlns:ctl="clr-namespace:TransportDouala.Controls" xmlns:draw="clr-namespace:TransportDouala.Drawing" x:Class="TransportDouala.Views.LoginPage" x:DataType="vm:LoginViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="16">
            <HorizontalStackLayout Spacing="12">
                <Border BackgroundColor="{StaticResource Primary}" WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                    <Label Text="🚌" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="TransportDouala" Style="{StaticResource H2}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Bienvenue sur TransportDouala" Style="{StaticResource Title}" Margin="0,18,0,0" />
            <Label Text="Retrouvez facilement vos itinéraires, arrêts et tarifs à Douala." Style="{StaticResource Muted}" FontSize="16" />

            <ctl:FormField Title="Adresse e-mail" Placeholder="exemple@email.com" InputKeyboard="Email"
                           Text="{Binding Email, Mode=TwoWay}" ErrorText="{Binding EmailError}" />
            <ctl:FormField Title="Mot de passe" Placeholder="Saisissez votre mot de passe" IsPassword="True"
                           Text="{Binding Password, Mode=TwoWay}" />

            <Border IsVisible="{Binding HasError}" Style="{StaticResource Chip}" BackgroundColor="{StaticResource DangerBg}">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
            </Border>

            <Label Text="Mot de passe oublié ?" TextColor="{StaticResource Primary}" FontAttributes="Bold" HorizontalOptions="End">
                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" /></Label.GestureRecognizers>
            </Label>

            <Button Text="{Binding ButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" HeightRequest="24" />

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="ou" Style="{StaticResource Muted}" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Center" />
            </Grid>

            <Button Text="Créer un compte" Style="{StaticResource SecondaryButton}" Command="{Binding GoRegisterCommand}" />

            <Label Text="🔒  Vos données personnelles restent privées et ne sont pas revendues." Style="{StaticResource Muted}" Margin="0,24,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
